# ══════════════════════════════════════════════
# BOT ORTAM DEĞİŞKENLERİ
# ══════════════════════════════════════════════

# ── Veritabanı ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=token_sistem
DB_USER=token_admin
DB_PASSWORD=SIFRE_BURAYA

# ── Instagram / Meta API ──
META_APP_ID=META_APP_ID_BURAYA
META_APP_SECRET=META_APP_SECRET_BURAYA

# ── TikTok API ──
# https://developers.tiktok.com → App oluştur → Login Kit + video.list scope
TIKTOK_CLIENT_KEY=TIKTOK_CLIENT_KEY_BURAYA
TIKTOK_CLIENT_SECRET=TIKTOK_CLIENT_SECRET_BURAYA

# ── Şifreleme (Instagram/TikTok token decrypt — Python+Node.js uyumlu HKDF) ──
ENCRYPTION_KEY=BURAYA_GIZLI_ANAHTAR_STRINGI

# ── TRON (USDT TRC20 Transfer) ──
TRON_NETWORK=nile
TRON_PRIVATE_KEY=TRON_CUEZDAN_PRIVATE_KEY_HEX
TRON_API_KEY=

# ── Bot Ayarları ──
BOT_RUN_HOUR=4
BOT_RUN_MINUTE=0
DRY_RUN=true
LOG_LEVEL=INFO
