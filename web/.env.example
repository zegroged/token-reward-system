# ══════════════════════════════════════════════
# TOKEN ÖDÜL SİSTEMİ — ORTAM DEĞİŞKENLERİ
# .env.local dosyasını oluşturup değerleri girin
# ══════════════════════════════════════════════

# ── Veritabanı ──
DATABASE_URL="postgresql://token_admin:SIFRE_BURAYA@localhost:5432/token_sistem?schema=public"

# ── Redis (Session + Rate Limit) ──
REDIS_URL="redis://localhost:6379"

# ── JWT ──
JWT_SECRET="BURAYA_64_KARAKTER_RANDOM_HEX"
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Şifreleme Anahtarı (AES-256-GCM + HKDF — Instagram/TikTok tokenları) ──
# Python botu ve Node.js aynı anahtarı kullanır (HKDF ile türetilir).
ENCRYPTION_KEY="BURAYA_GIZLI_ANAHTAR_STRINGI"

# ── Internal API Key (Middleware ↔ Rate Limit API) ──
INTERNAL_API_KEY="BURAYA_RANDOM_INTERNAL_KEY"
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"

# ── Resend.com (E-posta) ──
# 1. https://resend.com adresinde ücretsiz hesap aç
# 2. API Key oluştur
# 3. Domain doğrulaması yap (DNS'e MX + SPF + DKIM kayıtları ekle)
RESEND_API_KEY="re_BURAYA_RESEND_API_ANAHTARI"
FROM_EMAIL="Token Sistem <noreply@DOMAIN_BURAYA>"

# ── Netgsm (SMS — Türkiye) ──
# 1. https://netgsm.com.tr adresinde hesap aç (OTP paketi al)
# 2. Kullanıcı adı ve şifre al
# 3. Başlık (header) talep et
NETGSM_USER="NETGSM_KULLANICI_ADI"
NETGSM_PASS="NETGSM_SIFRE"
NETGSM_HEADER="TOKEN"

# ── Instagram / Meta API ──
# 1. https://developers.facebook.com → App oluştur
# 2. Instagram Basic Display API ekle
# 3. OAuth Redirect URI ayarla
NEXT_PUBLIC_META_APP_ID="META_APP_ID_BURAYA"
META_APP_SECRET="META_APP_SECRET_BURAYA"
INSTAGRAM_REDIRECT_URI="https://DOMAIN_BURAYA/api/instagram/callback"
NEXT_PUBLIC_IG_REDIRECT_URI="https://DOMAIN_BURAYA/api/instagram/callback"

# ── TikTok API ──
# 1. https://developers.tiktok.com → App oluştur
# 2. Login Kit ekle, video.list scope iste
# 3. OAuth Redirect URI ayarla
TIKTOK_CLIENT_KEY="TIKTOK_CLIENT_KEY_BURAYA"
TIKTOK_CLIENT_SECRET="TIKTOK_CLIENT_SECRET_BURAYA"
TIKTOK_REDIRECT_URI="https://DOMAIN_BURAYA/api/tiktok/callback"
NEXT_PUBLIC_TIKTOK_REDIRECT_URI="https://DOMAIN_BURAYA/api/tiktok/callback"

# ── TRON (USDT Transfer) ──
# Network: "nile" (testnet) veya "mainnet"
TRON_NETWORK="nile"
# Cüzdan private key (HEX format, 0x prefix yok)
# Nile testnet faucet: https://nile.tronscan.org/#/wallet/faucet
TRON_PRIVATE_KEY="TRON_CUEZDAN_PRIVATE_KEY_HEX"
TRON_API_KEY=""

# ── Uygulama ──
NEXT_PUBLIC_APP_URL="https://DOMAIN_BURAYA"
NODE_ENV="production"

# ── Sentry (Hata İzleme — Opsiyonel) ──
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"
# SENTRY_AUTH_TOKEN="sntrys_xxx"
